# Q3: для кожного замку Польщі — регіон (P131) з найбільшим населенням (P1082),
# один рядок на об'єкт; топ-10 за населенням регіону.
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT ?item ?itemLabel ?region ?regionLabel ?population WHERE {
  {
    SELECT ?item (SAMPLE(?reg) AS ?region) ?population WHERE {
      {
        # пара «замок — регіон» і найбільше значення населення цього регіону
        SELECT ?item ?reg (MAX(?p) AS ?population) WHERE {
          ?item wdt:P17 wd:Q36 ;
                wdt:P31/wdt:P279* wd:Q23413 ;
                wdt:P131 ?reg .
          FILTER NOT EXISTS { ?item wdt:P576 ?ended . }
          ?reg wdt:P1082 ?p .
        }
        GROUP BY ?item ?reg
      }
      # лишаємо регіон, населенішого за який у цього замку немає
      FILTER NOT EXISTS {
        ?item wdt:P131 ?other .
        ?other wdt:P1082 ?p2 .
        FILTER (?p2 > ?population)
      }
    }
    GROUP BY ?item ?population
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY DESC(?population) ?item
LIMIT 10
